<?xml version="1.0"?>
<!--
  Sensores do gêmeo digital. Os tópicos publicados aqui correspondem
  exatamente à telemetria que o firmware embarcado gera (02_Engenharia/08 §5),
  para que dados de simulação e de ensaio sejam diretamente comparáveis.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU: a proteção anti-tombamento depende dela. Ruído compatível com um
       BNO055/MPU6050 real — simular IMU perfeita esconde justamente o problema
       que o filtro complementar existe para resolver. -->
  <gazebo reference="imu_link">
    <sensor name="imu_bno055" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0035</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0035</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0035</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.045</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.045</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.045</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Câmera FPV: 150° de abertura e 640x480, como a câmera analógica real.
       Simular 1080p daria ao piloto uma percepção que ele não terá em campo. -->
  <gazebo reference="camera_fpv">
    <sensor name="camera_fpv" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera_fpv</topic>
      <gz_frame_id>camera_fpv</gz_frame_id>
      <camera>
        <horizontal_fov>2.618</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>60.0</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
