<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_frugal_description</name>
  <version>2.0.0</version>
  <description>
    Descrição URDF/xacro do Rover Frugal 4WD/4WS. Nenhum número de engenharia é
    escrito aqui: config/parametros.yaml é gerado a partir de
    00_Especificacao_Mestre/parametros_mestres.yaml.
  </description>
  <maintainer email="eduardomatheusfigueira@gmail.com">Eduardo Matheus Figueira</maintainer>
  <license>TODO: definir (ver README, seção Licença)</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
