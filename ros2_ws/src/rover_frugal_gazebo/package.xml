<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_frugal_gazebo</name>
  <version>2.0.0</version>
  <description>
    Mundos e integração com o Gazebo (gz-sim) para o Rover Frugal 4WD/4WS.
    Os mundos são gerados a partir dos parâmetros mestres: a escada simulada é
    necessariamente a mesma que dimensiona a roda.
  </description>
  <maintainer email="eduardomatheusfigueira@gmail.com">Eduardo Matheus Figueira</maintainer>
  <license>TODO: definir (ver README, seção Licença)</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>rover_frugal_description</exec_depend>
  <exec_depend>rover_frugal_control</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/../rover_frugal_description"/>
  </export>
</package>
